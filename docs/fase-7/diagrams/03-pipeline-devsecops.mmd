flowchart LR
  DEV["Push ou pull request<br/>na main do GitHub"]

  subgraph GHA["GitHub Actions, .github/workflows/devsecops.yml"]
    J1["1. Build e testes do app web<br/>Bun, Biome, TypeScript,<br/>testes da automação, next build"]
    J2["2. Testes do Python<br/>pytest do simulador,<br/>/health da API de visão"]
    J3["3. Qualidade do código<br/>SonarQube num container<br/>e sonar-scanner"]
    J4["4. Imagens e vulnerabilidades<br/>docker compose build<br/>Trivy nas imagens e nos Dockerfiles"]
    GATE{"CRITICAL com<br/>correção publicada?"}
    J5["5. Execução ponta a ponta<br/>Mosquitto, banco, worker, simulador,<br/>app de produção, health, metrics,<br/>prints e pm4py"]
  end

  subgraph ART["Artefatos de cada execução"]
    A1[["relatorio-sonarqube"]]
    A2[["relatorios-trivy"]]
    A3[["execucao-ponta-a-ponta<br/>logs, banco, event log,<br/>health, metrics, prints, figuras"]]
  end

  JEN["Jenkinsfile<br/>os mesmos estágios, no laboratório<br/>devsecops/docker-compose.yml"]
  STOP["Pipeline para<br/>e a imagem não segue"]

  DEV --> J1
  DEV --> J2
  DEV --> J3
  J1 --> J4
  J2 --> J4
  J1 --> J5
  J4 --> GATE
  GATE -- "sim" --> STOP
  GATE -- "não" --> A2
  J3 --> A1
  J5 --> A3
  GHA -. "espelho para o Jenkins" .- JEN

  classDef job fill:#e0ecff,stroke:#1d4ed8,stroke-width:2px,color:#0b1f4d
  classDef art fill:#fef3c7,stroke:#b45309,stroke-width:2px,color:#451a03
  classDef infra fill:#eef1f5,stroke:#5f6b7a,stroke-width:2px,color:#1f2933
  classDef stop fill:#fde8e8,stroke:#b91c1c,stroke-width:2px,color:#450a0a
  class J1,J2,J3,J4,J5 job
  class A1,A2,A3 art
  class DEV,JEN infra
  class STOP stop
  style GHA fill:#f5f9ff,stroke:#1d4ed8,color:#0b1f4d
  style ART fill:#fffbeb,stroke:#b45309,color:#451a03
