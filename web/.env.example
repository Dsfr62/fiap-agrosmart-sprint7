# Copie para web/.env.local e preencha. Nunca commite o .env.local.
# Chave da OpenRouter: usada pelo Jev (decisões), pelo LLM (recomendações) e pelo relatório.
# Sem ela a demo roda, mas as decisões saem pelas regras de limiar (plano B).
OPENROUTER_API_KEY=

